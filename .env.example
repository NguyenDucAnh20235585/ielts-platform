# ============================================================
# IELTS PLATFORM - ENVIRONMENT SETUP
# ============================================================
#
# OPTION 1 - RECOMMENDED FOR TEAM MEMBERS
#
# 1. Clone the GitHub repository.
# 2. Get the .env.local file from the team's private storage.
#    Ask the project owner if you do not have access.
# 3. Place .env.local in the project root (next to package.json).
# 4. Run: npm install
# 5. Run: npm run dev
#
# No manual key configuration is required if the provided
# .env.local is valid for your development environment.
#
# IMPORTANT:
# - NEVER commit or push .env.local to GitHub.
# - NEVER share credentials in public channels.
# - Keep .env.local in the project root, not inside src/.
# - Do not use production credentials for local testing.
#
# OPTION 2 - MANUAL SETUP
#
# If you cannot access the team's private environment file:
# 1. Copy .env.example to .env.local.
# 2. Fill in the required values for your own environment.
# 3. Save the file and restart the development server.
#
# ============================================================

# --- Public (also used by the browser) ---
# Local Supabase: run `npx supabase start`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Get the anon/publishable key from `npx supabase status`
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Local Supabase database connection
# Hosted Supabase: use an appropriate connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

DATABASE_POOL_MAX=5

# Optional: additional allowed origins
APP_ORIGINS=

# Optional: public R2 URL for audio/images
R2_PUBLIC_BASE_URL=