# Copy to .env.local and fill in. Never commit .env.local (it is git-ignored).
# Values below are for the local Supabase stack started with `npx supabase start`.

# --- Public (also used by the browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# anon / publishable key printed by `npx supabase status`
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Local default. Hosted Supabase: use the pooler connection string and add ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_POOL_MAX=5
# Optional, comma-separated: extra origins allowed to call POST/PUT/PATCH/DELETE /api/*
# (by default only the app's own origin is allowed)
APP_ORIGINS=
# Optional: public base URL of the R2 bucket for audio/images (OI-11). Leave empty for Reading-only tests.
R2_PUBLIC_BASE_URL=
